generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                 String                      @id @default(cuid())
  email                              String                      @unique
  name                               String?
  password                           String?
  avatarUrl                          String?
  emailVerified                      DateTime?
  status                             UserStatus                  @default(ACTIVE)
  lastLoginAt                        DateTime?
  roleId                             String
  lembagaId                          String?
  isPlatformAdmin                    Boolean                     @default(false)
  createdAt                          DateTime                    @default(now())
  updatedAt                          DateTime                    @updatedAt
  avatarPublicId                     String?
  emailNotifications                 Boolean                     @default(true)
  phoneNumber                        String?
  waNotifications                    Boolean                     @default(true)
  auditLogs                          AuditLog[]
  distributionsApproved              Distribution[]              @relation("DistributionApprover")
  distributionsCreated               Distribution[]              @relation("DistributionCreator")
  programs                           Program[]
  programApprovals                   Program[]                   @relation("ProgramApprover")
  lembaga                            Lembaga?                    @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  role                               Role                        @relation(fields: [roleId], references: [id])
  lembagaApprovals                   Lembaga[]                   @relation("LembagaApprover")
  volunteerApplicationReviews        VolunteerApplication[]      @relation("VolunteerApplicationReviewer")
  volunteerApplicationVerifications  VolunteerApplication[]      @relation("VolunteerApplicationVerifier")
  volunteerActivitiesCreated         VolunteerActivity[]         @relation("VolunteerActivityCreator")
  journalsCreated                    Journal[]                   @relation("JournalCreator")
  journalsPosted                     Journal[]                   @relation("JournalPoster")
  withdrawalsRequested               Withdrawal[]                @relation("WithdrawalRequester")
  withdrawalsApproved                Withdrawal[]                @relation("WithdrawalApprover")
  amilPlatformChangeRequestsReviewed AmilPlatformChangeRequest[] @relation("AmilPlatformChangeRequestReviewer")
  notifications                      Notification[]
  bankChangesRequested               BankAccountChangeRequest[] @relation("BankChangeRequester")
  bankChangesReviewed                BankAccountChangeRequest[] @relation("BankChangeReviewer")

  @@map("users")
}

model Lembaga {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  logoUrl                    String?
  logoPublicId               String?
  status                     LembagaStatus               @default(PENDING)
  rejectionReason            String?
  approvedAt                 DateTime?
  approvedById               String?
  picName                    String                      @default("")
  picPhone                   String?
  address                    String                      @default("")
  description                String?
  officePhotoUrl             String?
  officePhotoPublicId        String?
  website                    String?
  izinYayasanNumber          String?
  bankCode                   String?
  accountNumber              String?
  accountHolder              String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  auditLogs                  AuditLog[]
  chartOfAccounts            ChartOfAccount[]
  distributions              Distribution[]
  donations                  Donation[]
  payments                   Payment[]
  programs                   Program[]
  users                      User[]
  documents                  LembagaDocument[]
  journals                   Journal[]
  programBalances            ProgramBalance[]
  volunteerApplications      VolunteerApplication[]
  volunteerActivities        VolunteerActivity[]
  balance                    InstitutionBalance?
  withdrawals                Withdrawal[]
  amilInstitutionSettings    AmilInstitutionSetting[]
  amilPlatformChangeRequests AmilPlatformChangeRequest[]
  accountingBook             AccountingBook?
  bankAccounts               LembagaBankAccount[]
  bankAccountChangeRequests  BankAccountChangeRequest[]
  approvedBy                 User?                       @relation("LembagaApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("lembagas")
}

/// Satu buku besar dimiliki oleh Platform atau oleh satu Lembaga.
/// Pemisahan ini mencegah aset/kewajiban Platform tercampur dengan laporan tenant.
model AccountingBook {
  id              String                  @id @default(cuid())
  ownerType       AccountingBookOwnerType
  lembagaId       String?                 @unique
  name            String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lembaga         Lembaga?                @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  chartOfAccounts ChartOfAccount[]
  journals        Journal[]

  @@index([ownerType])
  @@map("accounting_books")
}

enum AccountingBookOwnerType {
  PLATFORM
  LEMBAGA
}

model LembagaDocument {
  id           String              @id @default(cuid())
  lembagaId    String
  type         LembagaDocumentType
  fileUrl      String
  filePublicId String?
  originalName String?
  createdAt    DateTime            @default(now())
  lembaga      Lembaga             @relation(fields: [lembagaId], references: [id], onDelete: Cascade)

  @@map("lembaga_documents")
}

enum LembagaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LembagaDocumentType {
  AKTA_YAYASAN
  SK_KEMENKUMHAM
  NPWP
  OTHER
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  lembagaId String?
  action    AuditAction
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
  lembaga   Lembaga?    @relation(fields: [lembagaId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Program {
  id                         String                      @id @default(cuid())
  lembagaId                  String
  createdById                String
  title                      String
  slug                       String
  description                String
  targetAmount               Decimal                     @db.Decimal(12, 2)
  currentAmount              Decimal                     @default(0) @db.Decimal(12, 2)
  /// Bagian donasi yang benar-benar dapat disalurkan setelah alokasi amil.
  programFundAmount          Decimal                     @default(0) @db.Decimal(12, 2)
  /// Total seluruh penyaluran, baik dari saldo mustahiq maupun saldo amil.
  distributedAmount          Decimal                     @default(0) @db.Decimal(12, 2)
  mustahiqDistributedAmount  Decimal                     @default(0) @db.Decimal(12, 2)
  amilDistributedAmount      Decimal                     @default(0) @db.Decimal(12, 2)
  category                   ProgramCategory
  status                     ProgramStatus               @default(DRAFT)
  rejectionReason            String?
  approvedAt                 DateTime?
  approvedById               String?
  imageUrl                   String?
  startDate                  DateTime?
  endDate                    DateTime?
  isFeatured                 Boolean                     @default(false)
  amilPlatformPercentage     Decimal                     @db.Decimal(5, 2)
  amilInstitutionPercentage  Decimal                     @db.Decimal(5, 2)
  amilMaxTotalPercentage     Decimal                     @db.Decimal(5, 2)
  /// Usulan porsi amil platform khusus program ini. Null berarti memakai default snapshot.
  requestedAmilPlatformPercentage Decimal?               @db.Decimal(5, 2)
  amilPlatformChangeReason   String?
  amilLockedAt               DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  distributions              Distribution[]
  donations                  Donation[]
  journals                   Journal[]
  createdBy                  User                        @relation(fields: [createdById], references: [id])
  approvedBy                 User?                       @relation("ProgramApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lembaga                    Lembaga                     @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  volunteerActivities        VolunteerActivity[]
  amilPlatformChangeRequests AmilPlatformChangeRequest[]
  reviewHistory              ProgramReviewHistory[]
  balance                    ProgramBalance?
  withdrawals                Withdrawal[]

  @@unique([lembagaId, slug])
  @@unique([id, lembagaId])
  @@map("programs")
}

enum ProgramReviewStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Snapshot setiap kali program diajukan untuk direview. Riwayat ini tetap ada
/// ketika program ditolak, diperbaiki, lalu diajukan ulang.
model ProgramReviewHistory {
  id                          String              @id @default(cuid())
  programId                   String
  status                      ProgramReviewStatus @default(PENDING)
  defaultPlatformPercentage   Decimal             @db.Decimal(5, 2)
  requestedPlatformPercentage Decimal?            @db.Decimal(5, 2)
  institutionPercentage       Decimal             @db.Decimal(5, 2)
  maxTotalPercentage           Decimal             @db.Decimal(5, 2)
  platformChangeReason        String?
  rejectionReason             String?
  submittedAt                 DateTime            @default(now())
  reviewedAt                  DateTime?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, submittedAt])
  @@index([status, submittedAt])
  @@map("program_review_history")
}

model Donation {
  id                    String         @id @default(cuid())
  lembagaId             String
  programId             String
  donorName             String?
  donorEmail            String?
  donorPhone            String?
  amount                Decimal        @db.Decimal(12, 2)
  platformFee           Decimal        @default(0) @db.Decimal(12, 2)
  institutionAmount     Decimal        @default(0) @db.Decimal(12, 2)
  platformPercentage    Decimal        @default(0) @db.Decimal(5, 2)
  institutionPercentage Decimal        @default(0) @db.Decimal(5, 2)
  amilPlatformAmount    Decimal        @default(0) @db.Decimal(12, 2)
  amilInstitutionAmount Decimal        @default(0) @db.Decimal(12, 2)
  netAmount             Decimal        @default(0) @db.Decimal(12, 2)
  message               String?
  isAnonymous           Boolean        @default(false)
  status                DonationStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lembaga               Lembaga        @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program               Program        @relation(fields: [programId], references: [id])
  payment               Payment?

  @@index([donorPhone])
  @@map("donations")
}

model Payment {
  id                     String        @id @default(cuid())
  lembagaId              String
  donationId             String        @unique
  gatewayRef             String?       @unique
  xenditPaymentRequestId String?       @unique
  amount                 Decimal       @db.Decimal(12, 2)
  paymentMethod          String?
  status                 PaymentStatus @default(PENDING)
  expiresAt              DateTime?
  paidAt                 DateTime?
  metadata               Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  donation               Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  lembaga                Lembaga       @relation(fields: [lembagaId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Distribution {
  id              String                 @id @default(cuid())
  lembagaId       String
  programId       String
  createdById     String
  approvedById    String?
  amount          Decimal                @db.Decimal(12, 2)
  fundSource      DistributionFundSource @default(MUSTAHIQ)
  title           String
  description     String
  receiptImageUrl String?
  status          DistributionStatus     @default(PENDING)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  approvedBy      User?                  @relation("DistributionApprover", fields: [approvedById], references: [id])
  createdBy       User                   @relation("DistributionCreator", fields: [createdById], references: [id])
  lembaga         Lembaga                @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program         Program                @relation(fields: [programId], references: [id])

  @@map("distributions")
}

model Volunteer {
  id               String                 @id @default(cuid())
  name             String
  email            String                 @unique
  password         String
  phone             String
  addressDomicile  String?
  addressKtp       String?
  photoUrl         String?
  photoPublicId    String?
  ktpUrl           String?
  ktpPublicId      String?
  cvUrl            String?
  cvPublicId       String?
  status           VolunteerStatus        @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  applications     VolunteerApplication[]
  notifications    Notification[]

  @@map("volunteers")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String?
  volunteerId String?
  type        NotificationType @default(INFO)
  title       String
  message     String
  link        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer   Volunteer?       @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([volunteerId, readAt, createdAt])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

/// Kegiatan relawan dibuat oleh Lembaga — entitas mandiri (opsional terhubung
/// ke satu Program) yang dilamar relawan, bukan program donasi itu sendiri.
model VolunteerActivity {
  id           String                  @id @default(cuid())
  lembagaId    String
  programId    String?
  createdById  String
  title        String
  description  String
  location     String?
  activityDate DateTime?
  quota        Int?
  status       VolunteerActivityStatus @default(OPEN)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  lembaga      Lembaga                @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program      Program?               @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdBy    User                   @relation("VolunteerActivityCreator", fields: [createdById], references: [id])
  applications VolunteerApplication[]

  @@map("volunteer_activities")
}

model VolunteerApplication {
  id                 String                     @id @default(cuid())
  volunteerId        String
  activityId         String
  lembagaId          String
  status             VolunteerApplicationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  reportText         String?
  reportFileUrl      String?
  reportFilePublicId String?
  reportSubmittedAt  DateTime?
  reportNote         String?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  volunteer          Volunteer                  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  activity           VolunteerActivity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lembaga            Lembaga                    @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  reviewedBy         User?                      @relation("VolunteerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  verifiedBy         User?                      @relation("VolunteerApplicationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([volunteerId, activityId])
  @@map("volunteer_applications")
}

enum VolunteerStatus {
  ACTIVE
  SUSPENDED
}

enum VolunteerActivityStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Alur: PENDING -> APPROVED/REJECTED -> (APPROVED) relawan ikut kegiatan
/// -> REPORT_SUBMITTED (relawan submit laporan) -> COMPLETED (lembaga verifikasi).
enum VolunteerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  REPORT_SUBMITTED
  COMPLETED
}

/// Server-side session store for express-session (connect-pg-simple).
/// Managed by the session middleware; mirrored here so Prisma migrate
/// does not flag the table as drift.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PAYMENT_UPDATE
  DISTRIBUTION_UPDATE
  LEMBAGA_APPROVE
  LEMBAGA_REJECT
  PROGRAM_APPROVE
  PROGRAM_REJECT
  VOLUNTEER_APPLICATION_REVIEW
  VOLUNTEER_REPORT_SUBMIT
  VOLUNTEER_REPORT_VERIFY
  WITHDRAWAL_REQUEST
  WITHDRAWAL_APPROVE
  WITHDRAWAL_REJECT
}

enum ProgramCategory {
  ZAKAT
  INFAK_SEDEKAH
  WAKAF
  CSR
  DSKL
}

enum ProgramStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  COMPLETED
  CANCELLED
}

enum DistributionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum DistributionFundSource {
  MUSTAHIQ
  AMIL
}

// ─── Amil Configuration ───────────────────────────────────────────────────────

model AmilGlobalSetting {
  id                        String          @id @default(cuid())
  category                  ProgramCategory @unique
  maxTotalPercentage        Decimal         @db.Decimal(5, 2)
  defaultPlatformPercentage Decimal         @db.Decimal(5, 2)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@map("amil_global_settings")
}

model AmilInstitutionSetting {
  id                    String          @id @default(cuid())
  lembagaId             String
  category              ProgramCategory
  institutionPercentage Decimal         @db.Decimal(5, 2)
  platformPercentage    Decimal         @db.Decimal(5, 2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  lembaga Lembaga @relation(fields: [lembagaId], references: [id], onDelete: Cascade)

  @@unique([lembagaId, category])
  @@map("amil_institution_settings")
}

enum AmilPlatformChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Permohonan perubahan porsi amil platform yang diajukan lembaga saat
/// membuat program. Persetujuan mengubah konfigurasi kategori lembaga,
/// sehingga berlaku untuk donasi berikutnya pada kategori tersebut.
model AmilPlatformChangeRequest {
  id                          String                          @id @default(cuid())
  lembagaId                   String
  programId                   String?
  category                    ProgramCategory
  currentPlatformPercentage   Decimal                         @db.Decimal(5, 2)
  requestedPlatformPercentage Decimal                         @db.Decimal(5, 2)
  institutionPercentage       Decimal                         @db.Decimal(5, 2)
  reason                      String
  status                      AmilPlatformChangeRequestStatus @default(PENDING)
  reviewNote                  String?
  reviewedById                String?
  reviewedAt                  DateTime?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt

  lembaga    Lembaga  @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program    Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("AmilPlatformChangeRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([lembagaId, category, status])
  @@map("amil_platform_change_requests")
}

// ─── Accounting ───────────────────────────────────────────────────────────────

/// Chart of Accounts — sistem COA multi-tenant.
/// Setiap lembaga memiliki salinan template COA yang sama (sistem seed otomatis
/// saat lembaga disetujui). Lembaga tidak dapat menambah/mengedit/menghapus
/// akun sistem (isSystem=true, isEditable=false, isDeletable=false).
model ChartOfAccount {
  id               String              @id @default(cuid())
  accountingBookId String
  lembagaId        String?
  /// Identitas semantik stabil untuk auto-journal; kode akun boleh berubah.
  key              String
  code             String
  name             String
  accountType      AccountType
  normalBalance    NormalBalance
  /// true = akun ini hanya header/grouping, tidak boleh digunakan di jurnal
  isHeader         Boolean             @default(false)
  /// Kode akun induk dalam buku akuntansi yang sama
  parentCode       String?
  /// Level hirarki: 1=root, 2=group, 3=detail
  level            Int                 @default(1)
  isSystem         Boolean             @default(true)
  isEditable       Boolean             @default(false)
  isDeletable      Boolean             @default(false)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  accountingBook   AccountingBook      @relation(fields: [accountingBookId], references: [id], onDelete: Cascade)
  lembaga          Lembaga?            @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  journalDetails   JournalDetail[]
  bankAccount      LembagaBankAccount?

  @@unique([accountingBookId, code])
  @@unique([accountingBookId, key])
  @@index([accountingBookId])
  @@index([lembagaId])
  @@map("chart_of_accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  FUND
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// ─── Journal (Jurnal Umum) ────────────────────────────────────────────────────

/// Header jurnal — setiap transaksi akuntansi double-entry.
/// Nomor jurnal unik per lembaga: JU-YYYYMM-XXXXXX.
model Journal {
  id               String            @id @default(cuid())
  accountingBookId String
  lembagaId        String?
  journalNo        String
  journalDate      DateTime          @db.Date
  description      String
  sourceType       JournalSourceType @default(MANUAL)
  sourceId         String?
  sourceEvent      String            @default("PRIMARY")
  programId        String?
  status           JournalStatus     @default(DRAFT)
  createdById      String?
  postedById       String?
  postedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  accountingBook AccountingBook  @relation(fields: [accountingBookId], references: [id], onDelete: Cascade)
  lembaga        Lembaga?        @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  program        Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("JournalCreator", fields: [createdById], references: [id])
  postedBy       User?           @relation("JournalPoster", fields: [postedById], references: [id], onDelete: SetNull)
  details        JournalDetail[]

  @@unique([accountingBookId, journalNo])
  @@unique([accountingBookId, sourceType, sourceId, sourceEvent])
  @@index([accountingBookId])
  @@index([lembagaId])
  @@index([lembagaId, status])
  @@map("journals")
}

/// Baris jurnal — satu baris debit ATAU kredit (tidak boleh keduanya).
model JournalDetail {
  id          String   @id @default(cuid())
  journalId   String
  accountId   String
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)
  description String?
  createdAt   DateTime @default(now())

  journal Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@map("journal_details")
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum JournalSourceType {
  MANUAL
  DONATION
  DISTRIBUTION
  REFUND
  EXPENSE
  ASSET_PURCHASE
  WITHDRAWAL
}

// ─── Balance ──────────────────────────────────────────────────────────────────

/// Hak dana Lembaga yang masih tersimpan di payment gateway.
model InstitutionBalance {
  id                      String   @id @default(cuid())
  lembagaId               String   @unique
  /// Saldo tersedia gabungan; selalu mustahiqBalance + amilBalance.
  balance                 Decimal  @default(0) @db.Decimal(15, 2)
  /// Dana program/mustahiq yang belum ditarik dari payment gateway.
  mustahiqBalance         Decimal  @default(0) @db.Decimal(15, 2)
  /// Dana amil milik lembaga yang belum ditarik dari payment gateway.
  amilBalance             Decimal  @default(0) @db.Decimal(15, 2)
  /// Saldo gabungan yang sedang direservasi untuk penarikan.
  reservedBalance         Decimal  @default(0) @db.Decimal(15, 2)
  reservedMustahiqBalance Decimal  @default(0) @db.Decimal(15, 2)
  reservedAmilBalance     Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt               DateTime @updatedAt

  lembaga Lembaga @relation(fields: [lembagaId], references: [id], onDelete: Cascade)

  @@map("institution_balances")
}

/// Saldo dana yang masih berada di payment gateway, terisolasi untuk satu
/// program. Saldo ini adalah sumber otoritatif saat Lembaga mengajukan
/// penarikan; InstitutionBalance hanya menyimpan agregat lintas program.
model ProgramBalance {
  id                      String   @id @default(cuid())
  programId               String   @unique
  lembagaId               String
  balance                 Decimal  @default(0) @db.Decimal(15, 2)
  mustahiqBalance         Decimal  @default(0) @db.Decimal(15, 2)
  amilBalance             Decimal  @default(0) @db.Decimal(15, 2)
  reservedBalance         Decimal  @default(0) @db.Decimal(15, 2)
  reservedMustahiqBalance Decimal  @default(0) @db.Decimal(15, 2)
  reservedAmilBalance     Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt               DateTime @updatedAt

  program Program @relation(fields: [programId, lembagaId], references: [id, lembagaId], onDelete: Cascade)
  lembaga Lembaga @relation(fields: [lembagaId], references: [id], onDelete: Cascade)

  @@index([lembagaId])
  @@unique([programId, lembagaId])
  @@map("program_balances")
}

/// Satu-satunya rekening pencairan milik Lembaga, terhubung ke akun COA Bank.
model LembagaBankAccount {
  id               String   @id @default(cuid())
  lembagaId        String
  chartOfAccountId String   @unique
  bankCode         String
  accountNumber    String
  accountHolder    String
  label            String?
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lembaga        Lembaga        @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  chartOfAccount ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)
  withdrawals    Withdrawal[]

  @@unique([lembagaId])
  @@index([lembagaId, isActive])
  @@map("lembaga_bank_accounts")
}

/// Saldo operasional bagian Platform yang masih berada di payment gateway.
model PlatformBalance {
  id              String   @id @default("platform")
  balance         Decimal  @default(0) @db.Decimal(15, 2)
  reservedBalance Decimal  @default(0) @db.Decimal(15, 2)
  bankCode        String?
  accountNumber   String?
  accountHolder   String?
  updatedAt       DateTime @updatedAt

  @@map("platform_balances")
}

enum BankAccountChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Null lembagaId identifies the single Platform account. The migration enforces
/// one pending request per owner, including Platform (PostgreSQL partial indexes).
model BankAccountChangeRequest {
  id               String                  @id @default(cuid())
  lembagaId        String?
  bankCode         String
  accountNumber    String
  accountHolder    String
  changeReason     String
  label            String?
  previousBankCode      String
  previousAccountNumber String
  previousAccountHolder String
  status           BankAccountChangeStatus @default(PENDING)
  rejectionReason  String?
  requestedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  lembaga          Lembaga? @relation(fields: [lembagaId], references: [id], onDelete: Cascade, map: "bank_changes_lembaga_fkey")
  requestedBy      User @relation("BankChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict, map: "bank_changes_requester_fkey")
  reviewedBy       User? @relation("BankChangeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, map: "bank_changes_reviewer_fkey")

  @@index([lembagaId, createdAt])
  @@index([status, createdAt])
  @@map("bank_account_change_requests")
}

// ─── Withdrawal ───────────────────────────────────────────────────────────────

model Withdrawal {
  id              String           @id @default(cuid())
  lembagaId       String?
  isPlatform      Boolean          @default(false)
  bankAccountId   String?
  programId       String?
  amount          Decimal          @db.Decimal(15, 2)
  /// Komponen saldo program yang dikunci saat request dibuat. Snapshot ini
  /// memastikan reject/failure mengembalikan dana ke sumber yang persis sama.
  mustahiqAmount  Decimal          @default(0) @db.Decimal(15, 2)
  amilAmount      Decimal          @default(0) @db.Decimal(15, 2)
  status          WithdrawalStatus @default(PENDING)
  bankCode        String
  accountNumber   String
  accountHolder   String
  rejectionReason String?
  requestedById   String
  approvedById    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lembaga     Lembaga?            @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  requestedBy User                @relation("WithdrawalRequester", fields: [requestedById], references: [id])
  approvedBy  User?               @relation("WithdrawalApprover", fields: [approvedById], references: [id])
  payout      Payout?
  bankAccount LembagaBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  program     Program?            @relation(fields: [programId, lembagaId], references: [id, lembagaId], onDelete: Restrict)

  @@index([bankAccountId])
  @@index([programId])
  @@map("withdrawals")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

model Payout {
  id             String       @id @default(cuid())
  withdrawalId   String       @unique
  xenditPayoutId String?      @unique
  referenceId    String       @unique
  idempotencyKey String       @unique
  amount         Decimal      @db.Decimal(15, 2)
  channelCode    String
  accountNumber  String
  accountHolder  String
  status         PayoutStatus @default(REQUESTED)
  failureCode    String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@map("payouts")
}

enum PayoutStatus {
  REQUESTED
  ACCEPTED
  PROCESSING
  SUCCEEDED
  FAILED
  LOCKED
  CANCELLED
  REVERSED
}
